# Local Hub env — copy to .env and fill in. Never commit .env.
# Shell environment variables still win over this file.

HUB_RESIDENT_MODE=live
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=enabled

