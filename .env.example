# Local Hub env — copy to .env and fill in. Never commit .env.
# Shell environment variables still win over this file.

HUB_RESIDENT_MODE=live
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=enabled

# DEEPSEEK_THINKING=disabled
# DEEPSEEK_MODEL=deepseek-v4-flash
# HUB_PORT=3000
# HUB_FOREST_ACTIVE=false
# HUB_APPROVAL_MODE=confirm

# Live mode is Docker-only; fake mode keeps direct-host execution for tests and demos. The live image must
# already be available locally because sandbox recipe jobs use network=none.
# HUB_SANDBOX_BACKEND=docker
# HUB_SANDBOX_IMAGE=node:22-alpine
# HUB_SANDBOX_JOBS_ROOT=C:\path\to\disposable\hub-sandbox-bay
# HUB_RECIPE_TIMEOUT_MS=120000

# Result Rack exact custody and deterministic resident projection limits.
# HUB_RESULT_PATH=.runtime/results.sqlite
# HUB_RESULT_PROJECTION_MAX_BYTES=12000
# HUB_RESULT_PROJECTION_MAX_LINES=120

# Provider attention fitting. The refusal threshold must exceed the warning.
# HUB_ATTENTION_WARN_BYTES=80000
# HUB_ATTENTION_REFUSE_BYTES=120000
# HUB_RETAINED_TOOL_PAIRS=2

# HUB_RUNTIME_ROOT=.runtime
# HUB_DB_PATH=.runtime/hub.sqlite
# HUB_FOREST_PATH=.runtime/forest.sqlite
# HUB_SPINE_PATH=.runtime/spine/resident-seat-1.jsonl
# HUB_WORLD_PATH=.runtime/world.sqlite
# HUB_WORKSHOP_ROOT=.
# HUB_WORKSHOP_MAX_FILES=100
# HUB_WORKSHOP_MAX_BYTES=120000
# HUB_WORKSHOP_MAX_LINES=160
# HUB_WORKSHOP_MAX_RESULTS=50
